{
  "name": "cf-cfscript-docblock-hover",
  "displayName": "ColdFusion CFScript DocBlock Hover",
  "description": "Shows the docblock documentation (/** ... */) of CFScript functions on hover, in .cfc and in <cfscript> blocks of .cfm files",
  "version": "1.0.0",
  "publisher": "framecode",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/framecodeinc/cf-cfscript-docblock-hover.git"
  },

  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other"],
  "keywords": ["cfml", "coldfusion", "cfscript", "cfc", "docblock", "hover", "documentation"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cfml",
    "workspaceContains:**/*.cfc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cfml",
        "aliases": ["CFML", "ColdFusion"],
        "extensions": [".cfc", ".cfm", ".cfml"]
      },
      {
        "id": "cfscript-hover",
        "aliases": ["CFScript Hover"]
      }
    ],
    "grammars": [
      {
        "language": "cfscript-hover",
        "scopeName": "source.cfscript-hover",
        "path": "./syntaxes/cfscript-hover.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "CFScript DocBlock Hover",
      "properties": {
        "cfscriptDocblockHover.codeLanguage": {
          "type": "string",
          "default": "cfscript-hover",
          "description": "Language id used to color the code in the hover (e.g. cfscript-hover, typescript, javascript, cfml)."
        },
        "cfscriptDocblockHover.cfdocs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show documentation of native CFML functions, tags and statements fetched from CFDocs."
        },
        "cfscriptDocblockHover.cfdocs.baseUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/foundeo/cfdocs/master/data/en/",
          "pattern": "^https://.+",
          "patternErrorMessage": "Only https URLs are supported.",
          "description": "Base URL of the CFDocs JSON files (data/en/). Only https is supported."
        },
        "cfscriptDocblockHover.cfdocs.engines": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["coldfusion", "lucee", "boxlang"]
          },
          "uniqueItems": true,
          "default": ["coldfusion", "lucee", "boxlang"],
          "description": "Engines whose minimum versions are shown in the CFDocs hover."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}