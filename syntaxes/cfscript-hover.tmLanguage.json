{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CFScript Hover",
  "scopeName": "source.cfscript-hover",
  "patterns": [
    {
      "match": "^\\s*(component)\\b",
      "captures": {
        "1": { "name": "storage.type.class.ts" }
      }
    },
    { "include": "source.ts" }
  ]
}
